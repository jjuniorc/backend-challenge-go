# ── Aplicação ────────────────────────────────────────────────
APP_ENV=local
INSTANCE_ID=app1
LOG_LEVEL=info
HTTP_ADDR=:8080

# ── PostgreSQL (host: localhost | container: postgres) ──────
POSTGRES_DSN=postgres://wager:wager@localhost:5432/wager?sslmode=disable
POSTGRES_MAX_CONNS=10
# Porta publicada no HOST pelo docker-compose (onde o psql do host conecta).
POSTGRES_HOST_PORT=5432

# ── SQS emulado (host: localhost:4566 | container: ministack:4566)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
# SQS_QUEUE_URL é resolvida em runtime via GetQueueUrl para não
# depender do accountId do emulador. Preencha só se precisar forçar.
# SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
# SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo

# ── Consumidor da fila de entrada ───────────────────────────
CONSUMER_ENABLED=true
# Identidade do consumidor na inbox (inbox_messages.consumer_name).
CONSUMER_NAME=wager-transactions
CONSUMER_MAX_MESSAGES=10
CONSUMER_WAIT_TIME=20s
CONSUMER_VISIBILITY_TIMEOUT=30s
# Precisa CASAR com o maxReceiveCount do RedrivePolicy da fila
# (docs/init/ministack/01-queues.sh). Se divergirem, o consumidor encaminha para
# a DLQ antes do redrive do broker (perdendo tentativas úteis) ou depende de uma
# rodada que já não teria chance de sucesso.
CONSUMER_MAX_RECEIVE_COUNT=5
CONSUMER_BASE_BACKOFF=2s
# Prazo para concluir (ou liberar) o trabalho em andamento no SIGTERM.
CONSUMER_SHUTDOWN_GRACE=15s

# ── Worker de referências pendentes ─────────────────────────
# Retoma operações que ficaram em PENDING_REFERENCE esperando a referência.
REFERENCE_ENABLED=true
REFERENCE_INTERVAL=1s
# Espera após erro. Sem ela, um erro persistente repetiria a mesma operação
# em ciclo apertado, porque o rollback devolve a linha ao estado vencida.
REFERENCE_ERROR_BACKOFF=2s
# Política de espera: a MESMA que o caso de uso usa para agendar a retomada.
# MaxAttempts conta a tentativa inicial, que registra attempts=1.
REFERENCE_MAX_ATTEMPTS=8
REFERENCE_TTL=24h
REFERENCE_BASE_BACKOFF=5s
REFERENCE_MAX_BACKOFF=15m

# ── Autenticação ────────────────────────────────────────────
# oidc (padrão) valida tokens do IdP. dev habilita o autenticador de
# desenvolvimento, aceito APENAS com APP_ENV=local|dev|test.
AUTH_MODE=oidc

# ── OIDC / Keycloak ─────────────────────────────────────────
# Porta do Keycloak publicada no HOST. Use outra (ex.: 8090) se a 8080 estiver
# ocupada. O issuer é derivado desta porta, então o valor precisa ser o mesmo
# para o container, a aplicação e os testes.
KEYCLOAK_HOST_PORT=8080

# issuer: URL de FRONTEND (o mesmo que aparece no token / discovery)
OIDC_ISSUER=http://localhost:8080/realms/wager
# jwks: URL de BACKCHANNEL (o app busca a chave por dentro da rede docker)
OIDC_JWKS_URL=http://keycloak:8080/realms/wager/protocol/openid-connect/certs
OIDC_TOKEN_URL=http://localhost:8080/realms/wager/protocol/openid-connect/token
# Opcional: quando definida, a claim `aud` do token precisa contê-la.
OIDC_AUDIENCE=wager-api

# Credenciais de exemplo para obter token via client_credentials
PROVIDER_A_CLIENT_ID=provider-a
PROVIDER_A_CLIENT_SECRET=provider-a-secret
PROVIDER_B_CLIENT_ID=provider-b
PROVIDER_B_CLIENT_SECRET=provider-b-secret
INTERNAL_CLIENT_ID=internal-service
INTERNAL_CLIENT_SECRET=internal-secret
